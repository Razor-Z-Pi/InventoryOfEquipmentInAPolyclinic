<Window x:Class="InventoryOfEquipmentInAPolyclinic.LoginWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InventoryOfEquipmentInAPolyclinic"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="400"
      ResizeMode="NoResize"
      WindowStartupLocation="CenterScreen"
      Title="Вход в систему"
      Background="#ECF0F1">

    <Border Background="White" CornerRadius="10" Margin="30" Padding="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>

            <TextBlock Text="Логин" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" Padding="5" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Padding="5" FontSize="14" Margin="0,0,0,20"/>

            <Button Content="Войти" Click="LoginButton_Click" 
                    Height="35" FontSize="16" FontWeight="Bold"
                    Background="#3498DB" Foreground="White"/>
        </StackPanel>
    </Border>
</Window>
