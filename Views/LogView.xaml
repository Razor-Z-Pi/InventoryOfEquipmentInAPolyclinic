<UserControl x:Class="InventoryOfEquipmentInAPolyclinic.Views.LogView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InventoryOfEquipmentInAPolyclinic.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="10" Padding="10">
            <DataGrid ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="150"/>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding Username}" Width="120"/>
                    <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="120"/>
                    <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
