<UserControl x:Class="InventoryOfEquipmentInAPolyclinic.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Карточки -->
                <RowDefinition Height="*"/>
                <!-- Графики -->
            </Grid.RowDefinitions>

            <!-- Панель с цифрами -->
            <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            </WrapPanel>

            <!-- Панель с графиками -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Круговая диаграмма -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Распределение по статусам" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                        <lvc:PieChart Grid.Row="1"
                                      Series="{Binding StatusSeries}"
                                      LegendPosition="Bottom"
                                      TooltipPosition="Top"/>
                    </Grid>
                </Border>

                <!-- Столбчатая диаграмма -->
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Топ-5 кабинетов по загруженности" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding CabinetSeries}"
                                            XAxes="{Binding CabinetXAxes}"
                                            TooltipPosition="Top"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>